# Normalize line endings: store text files as LF in the repo, check them
# out with LF on every platform. Prevents Windows-style CRLF from leaking in.
* text=auto eol=lf

# Binary files — never modify line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.jar binary
*.apk binary
*.keystore binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# Windows-only scripts must keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
gradlew.bat text eol=crlf
